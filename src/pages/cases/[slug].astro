---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((c) => ({
    params: { slug: c.slug || c.data.slug },
    props: { case: c },
  }));
}

interface Props {
  case: CollectionEntry<'cases'>;
}
const { case: item } = Astro.props;
const d = item.data;
const { Content } = await item.render();

const base = import.meta.env.BASE_URL;

const EV_KEY: Record<string, string> = {
  官方披露: 'official',
  平台数据可查: 'platform',
  作者自述: 'self',
  第三方估算: 'est',
};
const EV_HINT: Record<string, string> = {
  官方披露: '公司/创始人自己公布的数字',
  平台数据可查: '商店/榜单/众筹等平台公开数字',
  作者自述: '作者本人公开说过，附原文链接',
  第三方估算: '第三方工具推算，只给区间不给精确数',
};
const evKey = EV_KEY[d.证据等级 ?? '官方披露'] ?? 'official';
const evHint = EV_HINT[d.证据等级 ?? '官方披露'] ?? '';

// 不同「类型」用不同的字段标签：获奖作品没有收入，讲主办方/赛事；插件讲安装量
const isAward = d.类型 === '获奖作品';
const isPlugin = d.类型 === '插件';
const moneyLabel = isAward ? '当前状态' : isPlugin ? '收入估算' : '月收入估算';
const makerLabel = isAward ? '团队 / 赛事' : '创始人/地区';

const facts: [string, string | undefined][] = [
  ['类型', d.类型],
  [makerLabel, d.创始人地区],
  ['营收模式', d.营收模式],
  [moneyLabel, d.月收入估算],
  ['流量来源', d.流量来源],
  ['可迁移点', d.可迁移点],
  ['数据口径', d.数据口径],
  ['原文链接', d.原文链接],
];
---

<Base title={`${d.name} · 案例库`}>
  <article class="case">
    <a class="back" href={base}>← 返回案例库</a>
    <h1 class="title">{d.name}</h1>

    <div class="evline">
      <span class={`ev ev-${evKey}`}>{d.证据等级}</span>
      <span class="ev-desc">{evHint}</span>
      {d.平台数据 && <span class="ev-platform-data">平台数据：{d.平台数据}</span>}
    </div>

    <div class="facts">
      {facts.filter(([, v]) => v).map(([k, v]) => (
        <div class="fact">
          <div class="fact-k">{k}</div>
          <div class="fact-v">
            {k === '原文链接' && v
              ? <a href={v} target="_blank" rel="noopener">{v}</a>
              : v}
          </div>
        </div>
      ))}
      <div class="fact">
        <div class="fact-k">分类</div>
        <div class="fact-v tags">
          {d.分类.split('/').map((t) => t.trim()).filter(Boolean).map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      </div>
    </div>

    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .back { color: var(--muted); text-decoration: none; font-size: 14px; }
  .title { font-size: 30px; margin: 12px 0 12px; }
  .evline {
    display: flex; align-items: center; flex-wrap: wrap; gap: 10px;
    margin-bottom: 16px; font-size: 13px; color: var(--muted);
  }
  .ev-desc { }
  .ev-platform-data {
    background: #f6f6f4; border: 1px solid var(--line);
    padding: 3px 10px; border-radius: 6px; color: var(--ink);
  }
  .ev {
    font-size: 12px; padding: 3px 10px; border-radius: 999px; display: inline-block;
  }
  .ev-official { background: #e6f6ec; color: #1a7f43; }
  .ev-platform { background: #e8f0fe; color: #1a56db; }
  .ev-self { background: #fff2e0; color: #a35c00; }
  .ev-est { background: #f0f0ee; color: #6b6b6b; }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 10px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 28px;
  }
  .fact-k { font-size: 12px; color: var(--muted); margin-bottom: 4px; }
  .fact-v { font-size: 14px; }
  .fact-v a { color: var(--accent); word-break: break-all; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag {
    font-size: 12px; background: #eef3ff; color: var(--accent);
    padding: 3px 9px; border-radius: 6px;
  }
  .prose { font-size: 16px; }
  .prose :global(h2) { font-size: 21px; margin: 32px 0 12px; }
  .prose :global(h3) { font-size: 17px; margin: 24px 0 8px; }
  .prose :global(p) { margin: 0 0 16px; }
  .prose :global(img) {
    max-width: 100%; height: auto; border: 1px solid var(--line);
    border-radius: 8px; margin: 8px 0 20px;
  }
  .prose :global(ul), .prose :global(ol) { padding-left: 22px; margin: 0 0 16px; }
  .prose :global(li) { margin-bottom: 6px; }
</style>
