---
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import { CATEGORIES, catOf } from '../data/categories';

const cases = await getCollection('cases');
const base = import.meta.env.BASE_URL;
// md 里的封面路径是 /case-site/cases/<slug>/site.png（适配 GitHub Pages 的硬编码）
// 这里剥离前缀，用 BASE_URL 重新拼，保证本地/线上一致
const stripBase = (p: string) => p.replace(/^\/case-site/, '');

// 封面文件是否存在：缺封面（流水线新写还没抓图）时置空 → 首页渲染 placeholder，不发 404 请求
const coverExists = (p: string) => {
  const file = path.join(process.cwd(), 'public', p.replace(/^\/?case-site\//, ''));
  return fs.existsSync(file);
};

// 内容类型（有序）+ 证据等级 key
const TYPES = [
  { key: '收入案例', label: '收入案例' },
  { key: '国内实践', label: '国内实践' },
  { key: '获奖作品', label: '获奖作品' },
  { key: '插件', label: '插件 / 小工具' },
  { key: '开源变现', label: '开源变现' },
] as const;
const EV_KEY: Record<string, string> = {
  官方披露: 'official',
  平台数据可查: 'platform',
  作者自述: 'self',
  第三方估算: 'est',
};
const EV_HINT: Record<string, string> = {
  官方披露: '公司/创始人自己公布的数字',
  平台数据可查: '商店/榜单/众筹等平台公开数字',
  作者自述: '作者本人公开说过，附原文',
  第三方估算: '第三方工具推算，只给区间',
};

// 组装卡片数据：大类来自映射表（未映射落「其他」），搜索字段扁平化
const cards = cases
  .map((c) => {
    const rawCover = c.data.封面;
    const cover = rawCover && coverExists(rawCover)
      ? base.replace(/\/$/, '') + stripBase(rawCover)
      : '';
    return {
      slug: c.slug || c.data.slug,
      name: c.data.name,
      one: c.data.一句话,
      mode: c.data.营收模式,
      income: c.data.月收入估算 || '',
      cat: catOf(c.slug || c.data.slug) ?? 'uncat',
      cover,
      type: c.data.类型 ?? '收入案例',
      ev: c.data.证据等级 ?? '官方披露',
      evKey: EV_KEY[c.data.证据等级 ?? '官方披露'] ?? 'official',
      platform: c.data.平台数据 || '',
    };
  })
  // 未分类排最后
  .sort((a, b) => (a.cat === 'uncat' ? 1 : 0) - (b.cat === 'uncat' ? 1 : 0));

const cardsJson = JSON.stringify(cards);
// 只留真的有案例的大类，避免空 chip
const catList = CATEGORIES.filter((c) => cards.some((x) => x.cat === c.key));
const catLabelsJson = JSON.stringify(
  Object.fromEntries([...catList.map((c) => [c.key, c.label]), ['uncat', '其他']])
);
const catKeysJson = JSON.stringify(catList.map((c) => c.key));
const typeList = TYPES.filter((t) => cards.some((x) => x.type === t.key));
const typesJson = JSON.stringify(typeList);
const evKeyJson = JSON.stringify(EV_KEY);
const evHintJson = JSON.stringify(EV_HINT);
const baseUrl = base;
const catName = (key: string) => CATEGORIES.find((c) => c.key === key)?.label ?? '其他';
---

<Base title="案例库 · 创业/独立开发者收入案例">
  <section class="intro">
    <h1>创业收入案例库</h1>
    <p>
      收集国内外真实的小生意 / 独立产品案例：它们怎么起步、怎么赚钱、流量从哪来。
      每个案例都讲清模式，方便你对照、借鉴。共 {cards.length} 篇。
    </p>
    <p class="ev-legend">
      每篇标了<strong>证据等级</strong>：
      <span class="ev ev-official">官方披露</span>
      <span class="ev ev-platform">平台数据可查</span>
      <span class="ev ev-self">作者自述</span>
      <span class="ev ev-est">第三方估算</span>
      ——数字能查到什么程度，就标到什么程度，不编。
    </p>
  </section>

  <div class="toolbar">
    <input
      id="search"
      type="search"
      placeholder="搜索产品名 / 一句话 / 营收模式…"
      autocomplete="off"
    />
    <div class="cats" id="types">
      <button class="chip active" data-type="all">全部类型</button>
      {typeList.map((t) => (
        <button class="chip" data-type={t.key}>{t.label}</button>
      ))}
    </div>
    <div class="cats" id="cats">
      <button class="chip sm active" data-cat="all">全部赛道</button>
      {catList.map((c) => (
        <button class="chip sm" data-cat={c.key}>{c.label}</button>
      ))}
    </div>
  </div>

  <p class="result-count" id="result-count">共 {cards.length} 篇</p>

  <!-- 无 JS 时服务端直接出全部卡片（渐进增强）；JS 启用后 render() 切到 12/页分页 -->
  <div class="grid" id="grid">
    {cards.map((c) => (
      <a class="card" href={`${base}cases/${c.slug}/`}>
        {c.cover
          ? <img class="card-img" src={c.cover} alt={c.name} loading="lazy" />
          : <div class="card-img placeholder"><span>{c.name}</span></div>
        }
        <div class="card-body">
          <div class="card-badges">
            {c.cat !== 'uncat' && <span class="card-badge">{catName(c.cat)}</span>}
            <span class={`ev ev-${c.evKey}`} title={EV_HINT[c.ev]}>{c.ev}</span>
          </div>
          <h3>{c.name}</h3>
          <p class="card-desc">{c.one}</p>
          <div class="card-meta">
            <span class="tag type">{c.type}</span>
            <span class="tag">{c.mode}</span>
            {c.income && <span class="tag muted">{c.income}</span>}
          </div>
        </div>
      </a>
    ))}
  </div>

  <nav class="pager" id="pager" hidden></nav>
</Base>

<script type="application/json" data-cards={cardsJson}></script>
<script type="application/json" data-catlabels={catLabelsJson}></script>
<script type="application/json" data-catkeys={catKeysJson}></script>
<script type="application/json" data-types={typesJson}></script>
<script type="application/json" data-evkey={evKeyJson}></script>
<script type="application/json" data-evhint={evHintJson}></script>
<script type="application/json" data-base={baseUrl}></script>

<style is:global>
  .intro h1 { font-size: 28px; margin: 0 0 8px; }
  .intro p { color: var(--muted); margin: 0 0 20px; max-width: 640px; }
  .ev-legend { font-size: 13px !important; display: flex; align-items: center; flex-wrap: wrap; gap: 6px; }
  .ev-legend strong { color: var(--ink); }
  .toolbar { margin-bottom: 12px; }
  #search {
    width: 100%;
    max-width: 420px;
    padding: 10px 14px;
    font-size: 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--card);
    color: var(--ink);
    outline: none;
    margin-bottom: 14px;
  }
  #search:focus { border-color: var(--accent); }
  .cats { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
  .chip {
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--muted);
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 13px;
    cursor: pointer;
  }
  .chip.sm { font-size: 12px; padding: 4px 11px; }
  .chip.active { background: var(--accent); color: #fff; border-color: var(--accent); }
  .result-count { color: var(--muted); font-size: 13px; margin: 4px 0 16px; min-height: 18px; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  .card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,0.06); }
  .card-img { width: 100%; height: 150px; object-fit: cover; background: #eee; display: block; }
  .card-img.placeholder {
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #f7f7f5, #e6e6e3);
    color: #6b6b6b; font-weight: 700; font-size: 20px;
  }
  .card-body { padding: 14px 16px 16px; }
  .card-body h3 { margin: 0 0 6px; font-size: 17px; }
  .card-desc { margin: 0 0 12px; font-size: 13px; color: var(--muted); }
  .card-meta { display: flex; flex-wrap: wrap; gap: 6px; }
  .card-badges { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; align-items: center; }
  .card-badge {
    font-size: 11px; background: #e8f0fe; color: var(--accent);
    padding: 2px 8px; border-radius: 999px; display: inline-block;
  }
  .tag {
    font-size: 12px;
    background: #eef3ff;
    color: var(--accent);
    padding: 3px 9px;
    border-radius: 6px;
  }
  .tag.type { background: #f3f0ff; color: #6b4de6; }
  .tag.muted { background: #f0f0ee; color: var(--muted); }
  /* 证据等级 badge：绿=官方，蓝=平台，橙=自述，灰=估算 */
  .ev {
    font-size: 11px; padding: 2px 8px; border-radius: 999px;
    display: inline-block; line-height: 1.6; cursor: help;
  }
  .ev-official { background: #e6f6ec; color: #1a7f43; }
  .ev-platform { background: #e8f0fe; color: #1a56db; }
  .ev-self { background: #fff2e0; color: #a35c00; }
  .ev-est { background: #f0f0ee; color: #6b6b6b; }
  .pager {
    display: flex; align-items: center; justify-content: center;
    gap: 6px; margin-top: 28px; flex-wrap: wrap;
  }
  .pager button {
    min-width: 34px; height: 34px; padding: 0 8px;
    border: 1px solid var(--line); background: var(--card);
    color: var(--muted); border-radius: 8px; font-size: 13px; cursor: pointer;
  }
  .pager button:hover:not(:disabled):not(.cur) { border-color: var(--accent); color: var(--accent); }
  .pager button.cur { background: var(--accent); color: #fff; border-color: var(--accent); }
  .pager button:disabled { opacity: 0.4; cursor: default; }
</style>

<script>
  // ---------- 读取 SSG 注入的数据 ----------
  // JSON 放在 <script> 的 data-* attribute，浏览器读 dataset 时自动反转义 HTML 实体
  const readJson = (attr: string) => {
    const el = document.querySelector(`script[data-${attr}]`) as HTMLScriptElement;
    return el ? JSON.parse(el.dataset[attr]!) : null;
  };
  interface Card {
    slug: string; name: string; one: string; mode: string; income: string;
    cat: string; cover: string; type: string; ev: string; evKey: string; platform: string;
  }
  const CARDS: Card[] = readJson('cards') ?? [];
  const CATS: Record<string, string> = readJson('catlabels') ?? {};
  const CAT_KEYS: string[] = readJson('catkeys') ?? [];
  const TYPES: Array<{ key: string; label: string }> = readJson('types') ?? [];
  const EV_HINT: Record<string, string> = readJson('evhint') ?? {};
  // base 不是 JSON，是裸路径字符串，直接读 attribute
  const BASE: string =
    document.querySelector('script[data-base]')?.getAttribute('data-base') ?? '/';
  const PAGE_SIZE = 12;

  // ---------- 状态 ----------
  let q = '';
  let cat = 'all';
  let type = 'all';
  let page = 1;

  const grid = document.getElementById('grid') as HTMLDivElement;
  const pager = document.getElementById('pager') as HTMLElement;
  const count = document.getElementById('result-count') as HTMLParagraphElement;
  const search = document.getElementById('search') as HTMLInputElement;
  const catsEl = document.getElementById('cats') as HTMLDivElement;
  const typesEl = document.getElementById('types') as HTMLDivElement;

  const haystack = (c: Card) =>
    `${c.name} ${c.one} ${c.mode} ${c.income} ${c.type} ${c.platform} ${CATS[c.cat] ?? ''}`.toLowerCase();
  const matches = (c: Card) =>
    (cat === 'all' || c.cat === cat) &&
    (type === 'all' || c.type === type) &&
    (!q || haystack(c).includes(q));

  function esc(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function cardHTML(c: Card): string {
    const img = c.cover
      ? `<img class="card-img" src="${esc(c.cover)}" alt="${esc(c.name)}" loading="lazy"/>`
      : `<div class="card-img placeholder"><span>${esc(c.name)}</span></div>`;
    const income = c.income ? `<span class="tag muted">${esc(c.income)}</span>` : '';
    const badge = c.cat !== 'uncat' ? `<span class="card-badge">${esc(CATS[c.cat])}</span>` : '';
    const ev = `<span class="ev ev-${esc(c.evKey)}" title="${esc(EV_HINT[c.ev] ?? '')}">${esc(c.ev)}</span>`;
    return `
      <a class="card" href="${BASE}cases/${esc(c.slug)}/">
        ${img}
        <div class="card-body">
          <div class="card-badges">${badge}${ev}</div>
          <h3>${esc(c.name)}</h3>
          <p class="card-desc">${esc(c.one)}</p>
          <div class="card-meta">
            <span class="tag type">${esc(c.type)}</span>
            <span class="tag">${esc(c.mode)}</span>${income}
          </div>
        </div>
      </a>`;
  }

  function render() {
    const list = CARDS.filter(matches);
    const maxPage = Math.max(1, Math.ceil(list.length / PAGE_SIZE));
    if (page > maxPage) page = maxPage;
    const start = (page - 1) * PAGE_SIZE;
    grid.innerHTML = list.slice(start, start + PAGE_SIZE).map(cardHTML).join('');

    if (q) count.textContent = `共 ${list.length} 篇 · “${search.value.trim()}”`;
    else if (cat !== 'all' || type !== 'all') count.textContent = `共 ${list.length} 篇`;
    else count.textContent = `共 ${CARDS.length} 篇`;

    // 分页条
    pager.innerHTML = '';
    if (maxPage <= 1) { pager.hidden = true; return; }
    pager.hidden = false;
    const mk = (label: string, p: number, opts: { disabled?: boolean; cur?: boolean } = {}) => {
      const b = document.createElement('button');
      b.textContent = label;
      if (opts.cur) b.classList.add('cur');
      if (opts.disabled) { b.disabled = true; return b; }
      b.addEventListener('click', () => { page = p; render(); window.scrollTo({ top: 0, behavior: 'smooth' }); });
      return b;
    };
    pager.appendChild(mk('‹ 上一页', page - 1, { disabled: page === 1 }));
    const win: (number | '…')[] = [];
    for (let p = 1; p <= maxPage; p++) {
      if (p === 1 || p === maxPage || Math.abs(p - page) <= 2) win.push(p);
      else if (win[win.length - 1] !== '…') win.push('…');
    }
    win.forEach((p) => {
      if (p === '…') {
        const e = document.createElement('span');
        e.textContent = '…';
        e.style.cssText = 'color:var(--muted);padding:0 4px;';
        pager.appendChild(e);
      } else {
        pager.appendChild(mk(String(p), p, { cur: p === page }));
      }
    });
    pager.appendChild(mk('下一页 ›', page + 1, { disabled: page === maxPage }));
  }

  // ---------- 事件 ----------
  search.addEventListener('input', () => {
    q = search.value.trim().toLowerCase();
    page = 1;
    render();
  });
  catsEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn || !btn.dataset.cat) return;
    catsEl.querySelectorAll('.chip').forEach((c) => c.classList.remove('active'));
    btn.classList.add('active');
    cat = btn.dataset.cat!;
    page = 1;
    render();
  });
  typesEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn || !btn.dataset.type) return;
    typesEl.querySelectorAll('.chip').forEach((c) => c.classList.remove('active'));
    btn.classList.add('active');
    type = btn.dataset.type!;
    page = 1;
    render();
  });

  render();
</script>
